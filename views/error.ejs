<% layout("/layouts/boilerplate") %>

<div class="row mt-5">
  <div class="col-8 offset-2">
    <div class="alert alert-danger p-4 shadow-sm rounded-4" role="alert">
      <div class="d-flex align-items-center gap-3 mb-2">
        <i class="fa-solid fa-triangle-exclamation fa-2xl text-danger"></i>
        <h3 class="alert-heading mb-0 font-bold">Something went wrong!</h3>
      </div>
      <hr>
      <p class="mb-1 text-dark fs-5"><%= message %></p>
      <small class="text-muted">Error Status Code: <%= err.statusCode || 400 %></small>
    </div>
    <a href="/listings/new" class="btn btn-dark mt-2 rounded-pill px-4">Try Again</a>
    <a href="/listings" class="btn btn-outline-secondary mt-2 rounded-pill px-4">Back to All Listings</a>
  </div>
</div>
