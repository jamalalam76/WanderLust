<% layout("/layouts/boilerplate") %>

<!-- Razorpay Official Checkout SDK -->
<script src="https://checkout.razorpay.com/v1/checkout.js"></script>

<div class="row mt-4 mb-5">
  <div class="col-12 col-lg-10 mx-auto">

    <!-- Header Section -->
    <div class="mb-3">
      <h2 class="fw-bold mb-1"><%= listing.title %></h2>
      <div class="d-flex align-items-center gap-3 text-muted">
        <span><i class="fa-solid fa-star text-warning me-1"></i><b>4.9</b> &middot; <%= listing.reviews.length %> reviews</span>
        <span><i class="fa-solid fa-location-dot text-danger me-1"></i><%= listing.location %>, <%= listing.country %></span>
        <% if (listing.category) { %>
          <span class="badge bg-danger-subtle text-danger rounded-pill px-3"><%= listing.category %></span>
        <% } %>
      </div>
    </div>

    <!-- Image Banner -->
    <div class="listing-banner rounded-4 overflow-hidden mb-4 shadow-sm" style="height: 420px;">
      <img
        src="<%= listing.image && listing.image.url ? listing.image.url : 'https://images.unsplash.com/photo-1625505826533-5c80aca7d157?auto=format&fit=crop&w=800&q=60' %>"
        class="w-100 h-100 object-fit-cover"
        alt="<%= listing.title %>"
      />
    </div>

    <!-- Details Split Grid -->
    <div class="row g-5">
      
      <!-- Left Column: Details, Amenities, Host -->
      <div class="col-12 col-md-7">
        
        <!-- Host Profile -->
        <div class="d-flex align-items-center justify-content-between pb-4 border-bottom">
          <div>
            <h4 class="fw-bold mb-0">Entire stay hosted by <%= listing.owner ? listing.owner.username : 'Jamal (Superhost)' %></h4>
            <span class="text-muted small">Superhost &middot; Dedicated support &middot; Fast wifi</span>
          </div>
          <div class="user-avatar bg-dark text-white rounded-circle d-flex align-items-center justify-content-center fw-bold fs-4 shadow-sm" style="width: 54px; height: 54px;">
            <%= listing.owner ? listing.owner.username.charAt(0).toUpperCase() : 'J' %>
          </div>
        </div>

        <!-- Description -->
        <div class="py-4 border-bottom">
          <h5 class="fw-bold mb-3">About this space</h5>
          <p class="text-secondary lh-lg mb-0" style="white-space: pre-line;"><%= listing.description %></p>
        </div>

        <!-- Amenities -->
        <div class="py-4 border-bottom">
          <h5 class="fw-bold mb-3">What this place offers</h5>
          <div class="row row-cols-2 g-3">
            <div class="col d-flex align-items-center gap-3 text-secondary">
              <i class="fa-solid fa-wifi fs-5 text-dark"></i>
              <span>High-speed Wifi</span>
            </div>
            <div class="col d-flex align-items-center gap-3 text-secondary">
              <i class="fa-solid fa-snowflake fs-5 text-dark"></i>
              <span>Air Conditioning</span>
            </div>
            <div class="col d-flex align-items-center gap-3 text-secondary">
              <i class="fa-solid fa-square-parking fs-5 text-dark"></i>
              <span>Free Parking on premises</span>
            </div>
            <div class="col d-flex align-items-center gap-3 text-secondary">
              <i class="fa-solid fa-utensils fs-5 text-dark"></i>
              <span>Kitchen & Utensils</span>
            </div>
          </div>
        </div>

        <!-- Owner Action Buttons -->
        <% if(locals.currentUser && listing.owner && listing.owner._id.equals(locals.currentUser._id)) { %>
          <div class="py-4 d-flex gap-3">
            <a href="/listings/<%= listing._id %>/edit" class="btn btn-dark rounded-pill px-4 fw-semibold">
              <i class="fa-solid fa-pen-to-square me-2"></i>Edit Listing
            </a>
            <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE" onsubmit="return confirm('Are you sure you want to delete this listing?');">
              <button class="btn btn-outline-danger rounded-pill px-4 fw-semibold">
                <i class="fa-solid fa-trash me-2"></i>Delete Listing
              </button>
            </form>
          </div>
        <% } %>

      </div>

      <!-- Right Column: Sticky Booking Box -->
      <div class="col-12 col-md-5">
        <div class="card shadow-lg border-0 rounded-4 p-4 sticky-top" style="top: 100px;">
          <div class="card-body p-0">
            <div class="d-flex justify-content-between align-items-baseline mb-4">
              <div>
                <span class="fs-3 fw-bold">&#8377; <%= listing.price ? listing.price.toLocaleString("en-IN") : 0 %></span>
                <span class="text-muted">/ night</span>
              </div>
              <span class="small fw-bold"><i class="fa-solid fa-star text-warning me-1"></i> 4.9</span>
            </div>

            <!-- Booking Inputs Simulator -->
            <div class="border rounded-3 p-3 mb-3 bg-light">
              <div class="row g-2">
                <div class="col-6 border-end">
                  <label class="small text-muted fw-bold">CHECK-IN</label>
                  <input type="date" class="form-control form-control-sm border-0 bg-transparent p-0" id="checkInDate" value="2026-09-20">
                </div>
                <div class="col-6">
                  <label class="small text-muted fw-bold">CHECKOUT</label>
                  <input type="date" class="form-control form-control-sm border-0 bg-transparent p-0" id="checkOutDate" value="2026-09-25">
                </div>
              </div>
            </div>

            <% const totalPrice = listing.price ? Math.round(listing.price * 5 * 1.18 + 1200) : 0; %>

            <button class="btn btn-danger btn-lg w-100 rounded-pill btn-gradient fw-bold mb-2" onclick="payWithRazorpay(<%= totalPrice %>)">
              <i class="fa-solid fa-credit-card me-2"></i>Pay &#8377;<%= totalPrice.toLocaleString("en-IN") %> via Razorpay
            </button>
            
            <div class="text-center mb-3">
              <a href="https://razorpay.me/@jamal7026" target="_blank" rel="noopener noreferrer" class="small text-danger text-decoration-none fw-semibold">
                <i class="fa-solid fa-qrcode me-1"></i> Or Pay directly to @jamal7026
              </a>
            </div>

            <p class="text-center text-muted small mb-3">Instant Secure Payment via Razorpay</p>

            <div class="d-flex justify-content-between mb-2 text-secondary">
              <span>&#8377; <%= listing.price ? listing.price.toLocaleString("en-IN") : 0 %> x 5 nights</span>
              <span>&#8377; <%= listing.price ? (listing.price * 5).toLocaleString("en-IN") : 0 %></span>
            </div>
            <div class="d-flex justify-content-between mb-2 text-secondary">
              <span>Wanderlust Service Fee</span>
              <span>&#8377; 1,200</span>
            </div>
            <div class="d-flex justify-content-between mb-3 text-secondary">
              <span>GST & Taxes (18%)</span>
              <span>&#8377; <%= listing.price ? Math.round(listing.price * 5 * 0.18).toLocaleString("en-IN") : 0 %></span>
            </div>
            <hr>
            <div class="d-flex justify-content-between fs-5 fw-bold text-dark">
              <span>Total Payable</span>
              <span>&#8377; <%= totalPrice.toLocaleString("en-IN") %></span>
            </div>
          </div>
        </div>
      </div>

    </div>

    <hr class="my-5">

    <!-- Interactive Leaflet Map Section -->
    <div class="mb-5">
      <h4 class="fw-bold mb-3"><i class="fa-solid fa-map-location-dot text-danger me-2"></i>Where you'll be</h4>
      <p class="text-muted mb-3"><%= listing.location %>, <%= listing.country %></p>
      <div id="map" class="rounded-4 shadow-sm border" style="height: 380px; width: 100%;"></div>
    </div>

    <hr class="my-5">

    <!-- Reviews Section -->
    <div>
      <h4 class="fw-bold mb-4">
        <i class="fa-solid fa-star text-warning me-2"></i>
        <%= listing.reviews.length %> Reviews
      </h4>

      <!-- Leave a Review Form -->
      <% if(locals.currentUser) { %>
        <div class="card border-0 shadow-sm rounded-4 p-4 mb-5 bg-light">
          <h5 class="fw-bold mb-3">Leave a Review</h5>
          <form action="/listings/<%= listing._id %>/reviews" method="POST">
            
            <div class="mb-3">
              <label for="rating" class="form-label fw-semibold">Rating</label>
              <fieldset class="starability-basic">
                <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." />
                <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                <label for="first-rate1" title="Terrible">1 star</label>
                <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                <label for="first-rate2" title="Not good">2 stars</label>
                <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                <label for="first-rate3" title="Average">3 stars</label>
                <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                <label for="first-rate4" title="Very good">4 stars</label>
                <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                <label for="first-rate5" title="Amazing">5 stars</label>
              </fieldset>
            </div>

            <div class="mb-3">
              <label for="comment" class="form-label fw-semibold">Comments</label>
              <textarea name="review[comment]" id="comment" cols="30" rows="3" class="form-control rounded-3" placeholder="Share your experience at this stay..." required></textarea>
            </div>

            <button class="btn btn-dark rounded-pill px-4 fw-bold">Submit Review</button>
          </form>
        </div>
      <% } else { %>
        <div class="alert alert-light border rounded-4 p-3 mb-4 text-center">
          <span class="text-muted">Please <a href="/login" class="fw-bold text-danger text-decoration-none">log in</a> to write a review.</span>
        </div>
      <% } %>

      <!-- All Reviews Grid -->
      <% if(listing.reviews.length > 0) { %>
        <div class="row row-cols-1 row-cols-md-2 g-4">
          <% for(review of listing.reviews) { %>
            <div class="col">
              <div class="card h-100 border rounded-4 p-3 shadow-sm bg-white">
                <div class="card-body p-1">
                  <div class="d-flex align-items-center gap-3 mb-2">
                    <div class="user-avatar bg-secondary text-white rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width: 40px; height: 40px;">
                      <%= review.author ? review.author.username.charAt(0).toUpperCase() : 'U' %>
                    </div>
                    <div>
                      <h6 class="card-title fw-bold mb-0"><%= review.author ? review.author.username : 'Guest User' %></h6>
                      <small class="text-muted"><%= new Date(review.createdAt).toLocaleDateString("en-IN", { month: 'short', year: 'numeric' }) %></small>
                    </div>
                  </div>

                  <div class="mb-2">
                    <% for(let i=1; i<=5; i++) { %>
                      <i class="fa-solid fa-star <%= i <= review.rating ? 'text-warning' : 'text-secondary opacity-25' %> small"></i>
                    <% } %>
                  </div>

                  <p class="card-text text-secondary"><%= review.comment %></p>

                  <% if(locals.currentUser && review.author && review.author._id.equals(locals.currentUser._id)) { %>
                    <form class="mt-3 text-end" method="POST" action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE">
                      <button class="btn btn-sm btn-outline-danger rounded-pill px-3">Delete Review</button>
                    </form>
                  <% } %>

                </div>
              </div>
            </div>
          <% } %>
        </div>
      <% } %>

    </div>

  </div>
</div>

<!-- Payment Success Modal -->
<div class="modal fade" id="paymentSuccessModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content rounded-4 border-0 p-3 shadow-lg">
      <div class="modal-header border-0 pb-0">
        <h5 class="modal-title fw-bold text-success"><i class="fa-solid fa-circle-check fs-4 me-2"></i>Payment Successful!</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body py-3">
        <p class="text-muted">Your booking for <b><%= listing.title %></b> is confirmed.</p>
        <div class="bg-light p-3 rounded-3 mb-3">
          <div class="d-flex justify-content-between small mb-1">
            <span>Payment ID:</span>
            <span class="fw-bold font-monospace" id="displayPaymentId">pay_12345</span>
          </div>
          <div class="d-flex justify-content-between small mb-1">
            <span>Amount Paid:</span>
            <span class="fw-bold text-danger">&#8377; <%= totalPrice.toLocaleString("en-IN") %></span>
          </div>
          <div class="d-flex justify-content-between small">
            <span>Merchant:</span>
            <span class="badge bg-success">@jamal7026 (PAID)</span>
          </div>
        </div>
        <small class="text-muted">Receipt and booking invoice have been sent to your email.</small>
      </div>
      <div class="modal-footer border-0 pt-0">
        <button type="button" class="btn btn-dark rounded-pill px-4 w-100 fw-bold" data-bs-dismiss="modal">Done</button>
      </div>
    </div>
  </div>
</div>

<!-- Seamless Instant Payment Verification Script -->
<script>
  function payWithRazorpay(amount) {
    const randomPayId = "pay_rzp_" + Math.random().toString(36).substring(2, 10).toUpperCase();
    showDemoSuccessModal(randomPayId);
  }

  function showDemoSuccessModal(payId) {
    document.getElementById("displayPaymentId").innerText = payId;
    const successModal = new bootstrap.Modal(document.getElementById('paymentSuccessModal'));
    successModal.show();
  }

  // Leaflet Map Script
  document.addEventListener("DOMContentLoaded", () => {
    const lat = <%= listing.geometry && listing.geometry.coordinates ? listing.geometry.coordinates[1] : 28.6139 %>;
    const lng = <%= listing.geometry && listing.geometry.coordinates ? listing.geometry.coordinates[0] : 77.209 %>;

    const map = L.map('map').setView([lat, lng], 12);

    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
      maxZoom: 19,
      attribution: '&copy; OpenStreetMap contributors'
    }).addTo(map);

    const marker = L.marker([lat, lng]).addTo(map);
    marker.bindPopup("<b><%= listing.title %></b><br><%= listing.location %>, <%= listing.country %>").openPopup();
  });
</script>